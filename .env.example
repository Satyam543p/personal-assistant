# Kate / Jarvis Personal Assistant Environment Configuration
# Copy this file to .env and configure your environment variables.

# Hotkey Configuration
JARVIS_SIRI_HOTKEY=ctrl+space

# Cloud API Keys (Optional - only required for cloud LLM escalation)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# YouTube Data API Key (Optional - for YouTube knowledge ingestion)
YOUTUBE_API_KEY=

# Audio / Silent Mode Options (Optional)
# KATE_SILENT_MODE=1
# JARVIS_MUTE_SOUNDS=1
